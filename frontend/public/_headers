# Cloudflare Pages response headers (the same set as vercel.json, which stays
# for anyone deploying to Vercel instead). Cloudflare serves index.html for
# unknown paths on its own, because the build has no 404.html.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(self)
  Strict-Transport-Security: max-age=31536000; includeSubDomains
