# Copy to .env and fill in when needed. Both are empty by default, which keeps
# today's same-origin behaviour (requests go to a relative /api and /socket.io,
# forwarded by the Vite dev proxy in vite.config.js). Set them only when the
# frontend and backend are deployed to separate domains (e.g. Vercel + Render).

# VITE_API_URL=https://api.example.com
# VITE_SOCKET_URL=https://api.example.com
