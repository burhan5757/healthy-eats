# Copy to .env and fill in when needed. Both are empty by default, which keeps
# today's same-origin behaviour (requests go to a relative /api and /socket.io,
# forwarded by the Vite dev proxy in vite.config.js). Set them only when the
# frontend and backend are deployed to separate domains (e.g. Vercel + Render).

# Production: the API lives on a subdomain of the site (api.yourdomain.in next
# to yourdomain.in), so the staff login cookie stays first-party. See the
# README's "Deploying" section.
# VITE_API_URL=https://api.yourdomain.in
# VITE_SOCKET_URL=https://api.yourdomain.in

# Address search / reverse lookup at checkout. Any Nominatim-compatible service.
# Defaults to OpenStreetMap's public instance, which is rate-limited and not for
# production traffic — point this at a self-hosted or paid one before launch.
# VITE_GEOCODER_URL=https://nominatim.example.com
