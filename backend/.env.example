# Copy to .env and fill in. Never commit the real .env.
# On Render/Railway, set the same keys in the service's environment settings.
# The server REFUSES TO START if JWT_SECRET or either password hash is missing.

# Leave MONGODB_URI unset in development — an in-memory MongoDB starts
# automatically so the app runs with zero setup.
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net
# MONGODB_DB=healthy-eats

PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# --- Auth ---------------------------------------------------------------------

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs everyone out.
JWT_SECRET=

# Exactly one admin and one chef. Passwords are stored ONLY as bcrypt hashes
# (cost 12+), never in plain text. Generate a hash with:
#   npm run hash-password
# and paste it here in SINGLE quotes (the hash contains $ signs).
# To rotate: new hash here, restart — the account updates and its old sessions end.
ADMIN_NAME=Healthy Eats Admin
ADMIN_EMAIL=admin@healthyeats.in
ADMIN_PASSWORD_HASH=

CHEF_NAME=Kitchen
CHEF_EMAIL=chef@healthyeats.in
CHEF_PASSWORD_HASH=

# Hours a staff sign-in lasts (default 12).
# SESSION_TTL_HOURS=12

# Cookie SameSite. Default: none in production (frontend and API on different
# sites), lax in development. Use lax if the API is served from a subdomain of
# the frontend's domain (e.g. api.example.com + example.com).
# COOKIE_SAME_SITE=none

# Reverse proxies / load balancers in front of the app, so rate limits see the
# real visitor IP. Default: 1 in production (Render/Railway), 0 in development.
# TRUST_PROXY=1

# --- Rate limits (defaults shown) ----------------------------------------------
# RATE_LIMIT_LOGIN_PER_ACCOUNT=5    failed sign-ins per IP+email per 15 min
# RATE_LIMIT_LOGIN_PER_IP=30        failed sign-ins per IP per 15 min
# RATE_LIMIT_TRACK_PER_MINUTE=120   order-tracking lookups per IP per minute
# RATE_LIMIT_ORDERS=20              orders placed per IP per 10 min

# --- Tools ---------------------------------------------------------------------

# Only needed to run `npm run images:fetch` (free Pexels stock dish photos).
# Get a free key at https://www.pexels.com/api/ — no billing account needed.
# The server itself never reads this.
# PEXELS_API_KEY=
