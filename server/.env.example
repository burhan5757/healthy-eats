# Copy to .env and fill in. Never commit the real .env.

# Leave MONGODB_URI unset in development — an in-memory MongoDB starts
# automatically so the app runs with zero setup.
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/healthy-eats

PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# REQUIRED in production — the server refuses to boot with the dev default.
JWT_SECRET=change-me-to-a-long-random-string

# The single admin account. Seeded on first boot; there is no signup route for it.
ADMIN_NAME=Healthy Eats Admin
ADMIN_EMAIL=admin@healthyeats.in
ADMIN_PASSWORD=change-me-in-production

# The kitchen account.
CHEF_NAME=Kitchen
CHEF_EMAIL=chef@healthyeats.in
CHEF_PASSWORD=change-me-in-production
